# This service's OWN Postgres — never momoto-core's. `connection_limit` keeps the pool
# small: ingest is one short transaction per batch.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/momoto_analytics?connection_limit=5

# Must be IDENTICAL to momoto-core's (core signs access tokens; this only verifies them,
# for /v1/b/identify). A mismatch doesn't fail at boot — identify just answers 401.
JWT_SECRET=change-me-to-the-same-value-as-momoto-core

# The frontend origins allowed to send events. Requests carrying any other Origin get 403.
CORS_ORIGINS=http://localhost:5173

# Reverse-proxy hops in front of us (Railway: 1). Needed for per-IP rate limits.
# TRUST_PROXY=1

# Raw events, visits and identity links older than this are deleted daily.
# RETENTION_DAYS=90

# Per-IP budget for ingest requests per 10 minutes. Generous on purpose: mobile carriers
# put many phones behind one IP (CGNAT).
# INGEST_RATE_LIMIT=600

# PORT=3004
